// Bu dosyayı `Secrets.xcconfig` olarak kopyalayıp gerçek değerleri doldurun.
// `Secrets.xcconfig` .gitignore'da — asla commit edilmez.
//
//   cp Secrets.xcconfig.example Secrets.xcconfig
//
// CI'da (GitHub Actions) bu dosya secrets'tan otomatik üretilir; bkz. README.md "TestFlight" bölümü.

// Apple Developer Program Team ID (developer.apple.com/account → Membership).
DEVELOPMENT_TEAM = YOUR_TEAM_ID

// developer.apple.com'da bir uygulama oluşturup buradan alın (Client ID/Secret).
STRAVA_CLIENT_ID = YOUR_STRAVA_CLIENT_ID
STRAVA_CLIENT_SECRET = YOUR_STRAVA_CLIENT_SECRET
